# ================= Telegram =================
# my.telegram.org → API development tools (используется по умолчанию для всех sessions)
API_ID=
API_HASH=
# @BotFather
BOT_TOKEN=9228535989:AAHjmv53ou-R9UNMDGlNcyxNd291_e10Mmk
# Прошлые боты (через запятую) — с них один раз заберётся копия аккаунтов и подписчиков.
# Пусто = миграция не нужна.
OLD_BOT_TOKEN=
# Канал/чат, куда постить новые листинги (бот должен быть админом с правом публикации)
TARGET_CHAT_ID=-100xxxxxxxxxx
# Распределение лотов по темам форум-группы: диапазон_цен:чат/топик, через запятую.
# Пример: 300-1000 Stars → topic 2, 1000-3000 → 3, 3000+ → 4 (5000- значит «от 5000 и выше»)
PRICE_ROUTES=
# Отдельная тема по редкости/фону (приоритетнее PRICE_ROUTES): Backdrop:chat/topic, через запятую
BACKDROP_ROUTES=
# Тема по флору коллекции (floor) или по цене лота (price)
ROUTE_BY=floor
# Отсекать лоты, у которых цена выше флора более чем на N⭐ (0 = не ограничивать)
MAX_ABOVE_FLOOR=0
# Ваш Telegram ID (через запятую). Пусто → при запуске в консоли будет код для /claim
ADMIN_IDS=
# true — бот доступен всем (/status /sessions /add_session /stats /settings /test);
# /remove_session /reload /set и /test channel — всегда только для админов
ALLOW_ALL_USERS=true

# ================= Фильтр цены =================
MIN_STARS=5000
# Отслеживать только коллекции, где самый дешёвый лот на маркете (флор) от N Stars.
# Коллекции с флором 500⭐ пропускаются целиком — парсинг в разы быстрее. 0 = все коллекции.
COLLECTION_MIN_FLOOR=4500
# Что делать с коллекциями, где флор ниже порога:
#   skip — не читать совсем (по умолчанию): /set COLLECTION_MIN_FLOOR 3000 → только коллекции от 3000⭐
#   slow — всё-таки отслеживать, но реже (ищет дорогие лоты и в дешёвых коллекциях)
COLLECTION_FLOOR_MODE=skip

# Пропускать лоты, у которых Telegram скрыл владельца целиком (owner_id отсутствует,
