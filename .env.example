# ================= Telegram =================
# my.telegram.org → API development tools (используется по умолчанию для всех sessions)
API_ID=
API_HASH=
# @BotFather
BOT_TOKEN=
# Канал/чат, куда постить новые листинги (бот должен быть админом с правом публикации)
TARGET_CHAT_ID=-100xxxxxxxxxx
# Ваш Telegram ID (через запятую). Пусто → при запуске в консоли будет код для /claim
ADMIN_IDS=
# true — бот доступен всем (/status /sessions /add_session /stats /settings /test);
# /remove_session /reload /set и /test channel — всегда только для админов
ALLOW_ALL_USERS=true

# ================= Фильтр цены =================
MIN_STARS=5000
# Отслеживать только коллекции, где самый дешёвый лот на маркете (флор) от N Stars.
# Коллекции с флором 500⭐ пропускаются целиком — парсинг в разы быстрее. 0 = все коллекции.
COLLECTION_MIN_FLOOR=4500
# Порог для цены в TON (0 = не проверять). Курс Stars↔TON НЕ выдумывается.
MIN_TON=0
# Отправлять ли лоты, которые продаются ТОЛЬКО за TON (без цены в Stars)
ALLOW_TON_ONLY=false

# ================= Фильтр продавца =================
RUSSIAN_ONLY=true
# Русский продавец = whitelist, или видимый телефон +7, или описание профиля (bio) на русском.
# block — остальных отсеивать (только русские); allow — пропускать тех, о ком данных нет
UNKNOWN_SELLER_POLICY=block

# ================= Продавец: можно написать и мало NFT =================
# Только продавцы, которым можно написать бесплатно (без платных сообщений и «только Premium»)
REQUIRE_FREE_MESSAGES=true
# Не больше N NFT в профиле продавца (0 = не проверять)
MAX_SELLER_NFTS=12
# Максимальный Level продавца (0 = не проверять)
MAX_SELLER_LEVEL=5

# ================= Повторы =================
# Один и тот же NFT не отправлять повторно
UNIQUE_GIFTS=true
# Одного и того же продавца не отправлять повторно
UNIQUE_SELLERS=true
# Через сколько часов снова можно отправить продавца (0 = никогда)
SELLER_REPEAT_HOURS=0
# Не больше N лотов подряд из одной коллекции (1 = одинаковые гифты подряд не идут, 0 = без лимита)
MAX_SAME_COLLECTION_STREAK=1
# Префиксы телефона (если Telegram его показывает). 7 = Россия (и Казахстан)
SELLER_PHONE_PREFIXES=7

# ================= Трекер =================
# Первая синхронизация всегда ТИХАЯ: существующие лоты регистрируются, в канал ничего не уходит
INITIAL_SYNC=true
# 0 = читать ВСЕ страницы коллекции (обязательно для защиты от старых лотов)
INITIAL_SYNC_PAGES=0
# Сколько раз перечитать коллекцию, если за время синхронизации выдача «уехала»
SYNC_PASSES=3
RESYNC_RETRY_SECONDS=300
TRACKER_INTERVAL=1
PAGE_LIMIT=30
LIVE_MAX_PAGES=5
RECOVERY_MAX_PAGES=20
# Раз в N сек смотреть счётчики лотов всех коллекций (1 запрос). Изменился счётчик → коллекция опрашивается сразу
CATALOG_INTERVAL=3
# Коллекции без изменений опрашиваются для страховки раз в N сек
COLD_POLL_INTERVAL=20
# Снимок рынка в Telegram (ускоряет запуск после деплоя): раз в N минут, годен N часов
MARKET_BACKUP_MINUTES=30
MARKET_SNAPSHOT_MAX_AGE_HOURS=6
# Отслеживать только эти коллекции (названия или gift_id через запятую). Пусто = все.
COLLECTIONS=

# ================= Sessions / лимиты =================
MAX_CONCURRENT_SESSIONS=20
# Запросов в секунду на ОДНУ session
SESSION_RPS=1
# Запросов в секунду на ВСЕ sessions вместе (0 = без лимита)
GLOBAL_RPS=30
CONNECT_CONCURRENCY=5
# Сколько секунд ждать перед подключением аккаунтов при запуске. При деплое старая копия бота
# ещё может работать — если обе копии подключат один аккаунт, Telegram его аннулирует.
STARTUP_DELAY=25

# ================= Обработка / отправка =================
PROCESSOR_WORKERS=4
FETCH_FULL_SELLER=true
SELLER_CACHE_TTL=3600
SEND_INTERVAL=1.1

# ================= Test mode =================
TEST_MODE=false
TEST_MAX_MESSAGES=5
# Куда слать в TEST_MODE (пусто = первому админу)
TEST_CHAT_ID=

# ================= Прочее =================
TON_LABEL=TON
# Часовой пояс для времени в посте
TIMEZONE=Europe/Moscow

# ================= Резервная копия аккаунтов =================
# Ключ шифрования копии sessions (любая длинная строка). Без него аккаунты пропадут после деплоя.
SESSION_BACKUP_KEY=
# Куда бот кладёт и закрепляет копию (пусто = личка первого админа из ADMIN_IDS, а если его нет — канал TARGET_CHAT_ID)
SESSIONS_BACKUP_CHAT_ID=
DATABASE_PATH=data/tracker.db
SESSIONS_DIR=telegram_sessions
TEMPLATE_PATH=templates/listing.html
LOG_LEVEL=INFO
